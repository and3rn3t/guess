{
  "name": "@guess/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:tunnel": "expo start --tunnel",
    "dev:sim": "EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8788 expo start --dev-client --host localhost --port 8081",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "prebuild:ios": "expo prebuild --platform ios"
  },
  "dependencies": {
    "@guess/app-core": "workspace:*",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "expo": "^55.0.0",
    "expo-network": "^55.0.13",
    "expo-router": "~55.0.14",
    "react": "19.2.6",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "typescript": "~6.0.0"
  }
}
