{
  "name": "@guess/mobile",
  "private": true,
  "version": "0.0.1",
  "main": "index.js",
  "scripts": {
    "dev": "expo start --clear",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "prebuild:ios": "expo prebuild --platform ios && pnpm sync:xcode-env",
    "sync:xcode-env": "[ -d ios ] && cp .xcode.env ios/.xcode.env || echo 'iOS project missing; run pnpm prebuild:ios first'",
    "pods": "pnpm sync:xcode-env && cd ios && pod install",
    "open:xcode": "open ios/*.xcworkspace",
    "setup:xcode": "pnpm prebuild:ios && pnpm pods && pnpm open:xcode"
  },
  "dependencies": {
    "@guess/app-core": "workspace:*",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "expo": "^55.0.19",
    "expo-haptics": "^55.0.14",
    "expo-status-bar": "^3.0.8",
    "react": "^19.0.0",
    "react-native": "^0.83.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "typescript": "~6.0.3"
  }
}
