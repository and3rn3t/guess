# Set by expo-router. This enables Fabric-only features from react-native-screens
ENV['RNS_GAMMA_ENABLED'] ||= '1'
require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']

  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true'
# Disable Hermes V1 to fix "[runtime not ready]: TypeError: property is not writable"
ENV['RCT_HERMES_V1_ENABLED'] = '0'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'
inhibit_all_warnings!

prepare_react_native_project!

target 'Andernator' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false, # Force disable Hermes to fix runtime errors
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    # Fix: Expo pod's RCTAppDelegateUmbrella.h conditionally imports
    # <React_RCTAppDelegate/React_RCTAppDelegate-umbrella.h>, but when using
    # React-Core-prebuilt (prebuilt xcframework), that umbrella header is inside
    # React.xcframework and is not installed to Pods/Headers/Public. CocoaPods
    # installs the individual headers but not the umbrella, so __has_include fails
    # and RCTReactNativeFactory / RCTRootViewFactory are never declared.
    # Solution: create the missing umbrella header that forwards to the individual ones.
    # Fix: Expo pod's RCTAppDelegateUmbrella.h conditionally imports
    # <React_RCTAppDelegate/React_RCTAppDelegate-umbrella.h> (underscore dir), but CocoaPods
    # installs React-RCTAppDelegate headers to Headers/Public/React-RCTAppDelegate/ (dash dir).
    # __has_include resolves using the header search path "${PODS_ROOT}/Headers/Public", so it
    # looks for "Headers/Public/React_RCTAppDelegate/..." (underscore) which doesn't exist.
    # Solution: create the underscore-named directory and copy/create all umbrella headers there.
    rct_app_delegate_src_dir = "#{installer.sandbox.root}/Headers/Public/React-RCTAppDelegate"
    rct_app_delegate_underscore_dir = "#{installer.sandbox.root}/Headers/Public/React_RCTAppDelegate"
    umbrella_content = <<~UMBRELLA
      // Auto-generated by Podfile post_install.
      // Forwards to installed React-RCTAppDelegate headers.
      // Required because Expo's RCTAppDelegateUmbrella.h uses:
      //   __has_include(<React_RCTAppDelegate/React_RCTAppDelegate-umbrella.h>)
      // CocoaPods installs headers to React-RCTAppDelegate/ (dash), but the import
      // uses React_RCTAppDelegate/ (underscore). We bridge by creating both.
      #ifdef __OBJC__
      #import <UIKit/UIKit.h>
      #endif
      #import "RCTAppDelegate.h"
      #import "RCTAppSetupUtils.h"
      #import "RCTArchConfiguratorProtocol.h"
      #import "RCTDefaultReactNativeFactoryDelegate.h"
      #import "RCTDependencyProvider.h"
      #import "RCTJSRuntimeConfiguratorProtocol.h"
      #import "RCTReactNativeFactory.h"
      #import "RCTRootViewFactory.h"
      #import "RCTUIConfiguratorProtocol.h"
    UMBRELLA

    if Dir.exist?(rct_app_delegate_src_dir)
      # Add umbrella headers to the dash-named directory too
      ['React-RCTAppDelegate-umbrella.h', 'React_RCTAppDelegate-umbrella.h'].each do |fname|
        path = "#{rct_app_delegate_src_dir}/#{fname}"
        File.write(path, umbrella_content) unless File.exist?(path)
      end

      # Create the underscore-named directory that __has_include actually resolves to
      FileUtils.mkdir_p(rct_app_delegate_underscore_dir)
      Dir.glob("#{rct_app_delegate_src_dir}/*.h").each do |src|
        dst = "#{rct_app_delegate_underscore_dir}/#{File.basename(src)}"
        FileUtils.cp(src, dst)
      end
      ['React-RCTAppDelegate-umbrella.h', 'React_RCTAppDelegate-umbrella.h'].each do |fname|
        File.write("#{rct_app_delegate_underscore_dir}/#{fname}", umbrella_content)
      end
      puts "[Andernator] Created React_RCTAppDelegate/ (underscore) for Expo prebuilt compatibility."
    end

    # RN 0.85 prebuilt headers mark `devMenuConfiguration` as nonnull in
    # RCTRootViewFactory, while current Expo AppDelegate integration passes an
    # optional value. Patch generated public headers to keep Swift import
    # compatible until upstream versions converge.
    [
      "#{installer.sandbox.root}/Headers/Public/React-RCTAppDelegate/RCTRootViewFactory.h",
      "#{installer.sandbox.root}/Headers/Public/React_RCTAppDelegate/RCTRootViewFactory.h",
    ].each do |header_path|
      next unless File.exist?(header_path)

      content = File.read(header_path)
      patched = content.gsub(
        'devMenuConfiguration:(RCTDevMenuConfiguration *)devMenuConfiguration;',
        'devMenuConfiguration:(RCTDevMenuConfiguration *_Nullable)devMenuConfiguration;',
      )
      if patched != content
        File.write(header_path, patched)
      end
    end

    expo_swift_glob = "#{installer.sandbox.root}/../../../../node_modules/.pnpm/expo@*/node_modules/expo/ios/AppDelegates/ExpoReactNativeFactory.swift"
    Dir.glob(expo_swift_glob).each do |swift_path|
      swift_source = File.read(swift_path)
      swift_patched = swift_source.gsub(
        "launchOptions: launchOptions,\n        devMenuConfiguration: self.devMenuConfiguration",
        "launchOptions: launchOptions,\n        bundleConfiguration: self.bundleConfiguration,\n        devMenuConfiguration: self.devMenuConfiguration",
      )
      if swift_patched != swift_source
        File.write(swift_path, swift_patched)
        puts "[Andernator] Patched ExpoReactNativeFactory.swift for RN 0.85 bundleConfiguration compatibility."
      end
    end

    expo_mm_glob = "#{installer.sandbox.root}/../../../../node_modules/.pnpm/expo@*/node_modules/expo/ios/AppDelegates/EXReactRootViewFactory.mm"
    Dir.glob(expo_mm_glob).each do |mm_path|
      mm_source = File.read(mm_path)
      mm_patched = mm_source
        .gsub(
          "return [super viewWithModuleName:moduleName initialProperties:initialProperties launchOptions:launchOptions devMenuConfiguration:devMenuConfiguration];",
          "return [super viewWithModuleName:moduleName initialProperties:initialProperties launchOptions:launchOptions bundleConfiguration:[RCTBundleConfiguration defaultConfiguration] devMenuConfiguration:devMenuConfiguration];",
        )
      if mm_patched != mm_source
        File.write(mm_path, mm_patched)
        puts "[Andernator] Patched EXReactRootViewFactory.mm for RN 0.85 bundleConfiguration compatibility."
      end
    end

    # Xcode 26 + Expo SDK 55 + prebuilt RN: ExpoModulesJSI can fail to resolve
    # <folly/dynamic.h> from React-performancetimeline headers because the
    # ReactNativeDependencies header roots are not always in target search paths.
    # Add them explicitly for affected pod targets.
    installer.pods_project.targets.each do |target|
      next unless ['ExpoModulesJSI', 'React-performancetimeline'].include?(target.name)

      target.build_configurations.each do |build_config|
        header_paths = build_config.build_settings['HEADER_SEARCH_PATHS'] || '$(inherited)'
        header_paths = [header_paths] unless header_paths.is_a?(Array)

        additional_paths = [
          '$(PODS_ROOT)/Headers/Private/ReactNativeDependencies',
          '$(PODS_ROOT)/ReactNativeDependencies/Headers',
          '$(PODS_ROOT)/ReactNativeDependencies/framework/packages/react-native/ReactNativeDependencies.xcframework/Headers',
        ]

        additional_paths.each do |path|
          header_paths << path unless header_paths.include?(path)
        end

        build_config.build_settings['HEADER_SEARCH_PATHS'] = header_paths
      end
    end

    # Cleanup pass: keep Pod targets aligned to app minimum deployment target
    # and suppress third-party Pod warning noise (deprecations/static-analysis).
    min_ios_target = podfile_properties['ios.deploymentTarget'] || '15.1'
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_target
        build_config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'

        libtool_flags = build_config.build_settings['OTHER_LIBTOOLFLAGS'] || '$(inherited)'
        libtool_flags = [libtool_flags] unless libtool_flags.is_a?(Array)
        no_symbols_flag = '-no_warning_for_no_symbols'
        libtool_flags << no_symbols_flag unless libtool_flags.include?(no_symbols_flag)
        build_config.build_settings['OTHER_LIBTOOLFLAGS'] = libtool_flags
      end
    end

    # Reduce recurring Xcode warning noise in generated Pods project.
    installer.pods_project.root_object.attributes['LastUpgradeCheck'] = '1640'

    # Hermes pod's replace script is generated without outputs, which triggers
    # the "will be run during every build" warning. Add a stamp output and
    # touch it at script end so Xcode has an explicit dependency artifact.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'hermes-engine'

      target.shell_script_build_phases.each do |phase|
        next unless phase.name&.include?('[Hermes] Replace Hermes for the right configuration, if needed')

        stamp_path = '$(DERIVED_FILE_DIR)/hermes-engine-replace-hermes.stamp'
        phase.output_paths = [stamp_path]

        unless phase.shell_script.include?('hermes-engine-replace-hermes.stamp')
          phase.shell_script = <<~SCRIPT
            #{phase.shell_script}

            mkdir -p "${DERIVED_FILE_DIR}"
            /usr/bin/touch "${DERIVED_FILE_DIR}/hermes-engine-replace-hermes.stamp"
          SCRIPT
        end
      end
    end
  end
end
