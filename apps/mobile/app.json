{
  "expo": {
    "name": "Andernator Mobile",
    "slug": "guess-mobile",
    "scheme": "guessmobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andernet.guessmobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Andernator Mobile uses your local network in development to connect to the Metro bundler running on your Mac.",
        "NSBonjourServices": [
          "_http._tcp"
        ]
      }
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d5ec035-06c9-457f-8661-75313b09c16d"
      }
    },
    "owner": "andernet"
  }
}
