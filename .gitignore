# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*-dist
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/mcp.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
.env.local
.dev.vars

# Staging data (local ingestion DB) — ignore everything in data/ except the
# explicitly-allowed hand-curated files below.
data/*

# DQ.1 golden regression set is hand-curated and must be committed
!data/data-quality-golden.json

# DQ.2 vision-source URL cache (committed for reproducible CI)
!data/golden-image-sources.json

# Attribute schema cache is the source of truth for valid attribute keys —
# committed so CI (DQ.1 schema check) can validate without DB access.
!data/enrich-cache/
data/enrich-cache/*
!data/enrich-cache/attribute_definitions.json

# Simulation exported data (regenerate with pnpm simulate:export)
scripts/simulate/data/

# Wrangler local state
.wrangler/

# Test output
coverage/
playwright-report/
test-results/

# Generated migration chunks (too large for git)
migrations/chunks/
migrations/0005_ingest_characters.sql
migrations/0007_image_urls.sql
**/agent-eval-report*
pids
.file-manifest
.devcontainer/

.spark-workbench-id
.spark-initial-sha

# Wrangler temp build artifacts
.tmp-functions/

# Playwright MCP session artifacts
.playwright-mcp/

# nohup output
nohup.out
